{
  "dashboard": {
    "id": null,
    "uid": "storage-performance",
    "title": "存储与性能",
    "tags": ["storage", "database", "performance"],
    "timezone": "utc",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "15s",
    "panels": [
      {
        "id": 1,
        "title": "数据库连接池",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "synapse_database_pool_used / synapse_database_pool_max * 100",
            "refId": "A",
            "legendFormat": "使用率"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 80},
                {"color": "red", "value": 90}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "数据库查询时长",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(synapse_database_query_duration_seconds_bucket[5m]))",
            "refId": "A",
            "legendFormat": "p95 延迟"
          }
        ]
      },
      {
        "id": 3,
        "title": "TSDB 磁盘使用",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "prometheus_tsdb_storage_classes_bytes",
            "refId": "A",
            "legendFormat": "TSDB 大小"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "id": 4,
        "title": "Prometheus 内存使用",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 16},
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=\"prometheus\"}",
            "refId": "A",
            "legendFormat": "RSS 内存"
          }
        ]
      },
      {
        "id": 5,
        "title": "缓存命中率",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "instance:cache_hit_ratio:ratio5m",
            "refId": "A",
            "legendFormat": "缓存命中率"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 6,
        "title": "事件处理速率",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 32},
        "targets": [
          {
            "expr": "rate(synapse_persist_events_duration_seconds_count[5m])",
            "refId": "A",
            "legendFormat": "事件/秒"
          }
        ]
      }
    ],
    "templating": {
      "list": []
    },
    "time": {"from": "now-1h", "to": "now"},
    "title": "存储与性能"
  },
  "meta": {
    "folder": "synapse-rust",
    "slug": "storage-performance",
    "version": 1
  }
}