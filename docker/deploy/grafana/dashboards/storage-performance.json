{
  "id": null,
  "uid": "storage-performance",
  "title": "存储与性能",
  "tags": [
    "storage",
    "database",
    "performance"
  ],
  "timezone": "utc",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "数据库连接池",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "pool_utilization * 100",
          "refId": "A",
          "legendFormat": "使用率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "数据库查询 P95 时长",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_ms_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95 延迟(ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 3,
      "title": "TSDB 已加载块数",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "prometheus_tsdb_blocks_loaded",
          "refId": "A",
          "legendFormat": "已加载块数"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "title": "Prometheus 内存使用",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 16
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"prometheus\"}",
          "refId": "A",
          "legendFormat": "RSS 内存"
        }
      ]
    },
    {
      "id": 5,
      "title": "缓存命中率",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "100 * instance:cache_hit_ratio:ratio5m",
          "refId": "A",
          "legendFormat": "缓存命中率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 6,
      "title": "数据库查询速率",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 32
      },
      "targets": [
        {
          "expr": "rate(db_query_duration_ms_count[5m])",
          "refId": "A",
          "legendFormat": "查询/秒"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
