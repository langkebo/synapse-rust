      "targets": [
        {
          "expr": "rate(turn_packet_processed[5m])",
          "refId": "A",
          "legendFormat": "报文/秒"
        }
      ]
    },
    {
      "id": 4,
      "title": "TURN 限流桶占用率",
      "type": "stat",
