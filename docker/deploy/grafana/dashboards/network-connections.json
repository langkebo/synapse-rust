      "title": "TURN 分配速率",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(turn_total_allocations[5m])",
          "refId": "A",
          "legendFormat": "分配/秒"
        }
      ]
    },
    {
      "id": 3,
      "title": "TURN 报文处理速率",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
