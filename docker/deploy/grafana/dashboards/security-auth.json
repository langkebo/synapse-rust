{
  "dashboard": {
    "id": null,
    "uid": "security-auth",
    "title": "安全与认证",
    "tags": ["security", "auth", "authentication"],
    "timezone": "utc",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "登录请求速率",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(synapse_clientlogin_requests_total[5m])",
            "refId": "A",
            "legendFormat": "登录请求"
          }
        ]
      },
      {
        "id": 2,
        "title": "登录错误率",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(synapse_clientlogin_failure_total[5m]) / rate(synapse_clientlogin_requests_total[5m]) * 100",
            "refId": "A",
            "legendFormat": "错误率 %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "授权失败速率",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "rate(synapse_auth_failure_total[5m])",
            "refId": "A",
            "legendFormat": "授权失败"
          }
        ]
      },
      {
        "id": 4,
        "title": "限流状态",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "rate(synapse_rate_limit_rejections_total[5m])",
            "refId": "A",
            "legendFormat": "限流拒绝"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 5,
        "title": "E2EE 会话状态",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 24},
        "targets": [
          {
            "expr": "synapse_e2ee_session_count",
            "refId": "A",
            "legendFormat": "活跃会话"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 6,
        "title": "签名验证延迟",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(synapse_signing_duration_seconds_bucket[5m]))",
            "refId": "A",
            "legendFormat": "p95 延迟"
          }
        ]
      }
    ],
    "templating": {
      "list": []
    },
    "time": {"from": "now-1h", "to": "now"},
    "title": "安全与认证"
  },
  "meta": {
    "folder": "synapse-rust",
    "slug": "security-auth",
    "version": 1
  }
}