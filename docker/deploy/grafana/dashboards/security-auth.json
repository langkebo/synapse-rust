{
  "id": null,
  "uid": "security-auth",
  "title": "安全与认证",
  "tags": [
    "security",
    "auth",
    "authentication"
  ],
  "timezone": "utc",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "登录请求速率",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(auth_attempts_total[5m])",
          "refId": "A",
          "legendFormat": "登录请求"
        }
      ]
    },
    {
      "id": 2,
      "title": "登录错误率",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "100 * sum(rate(auth_failures_total[5m])) / sum(rate(auth_attempts_total[5m]))",
          "refId": "A",
          "legendFormat": "错误率 %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "授权失败速率",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "rate(auth_failures_total[5m])",
          "refId": "A",
          "legendFormat": "授权失败"
        }
      ]
    },
    {
      "id": 4,
      "title": "限流拒绝速率",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "rate(rate_limit_requests_rejected_total[5m])",
          "refId": "A",
          "legendFormat": "限流拒绝"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 5,
      "title": "E2EE 会话密钥读取速率",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 24
      },
      "targets": [
        {
          "expr": "rate(megolm_session_key_read_total[5m])",
          "refId": "A",
          "legendFormat": "密钥读取/秒"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 6,
      "title": "联邦请求 P95 延迟",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(federation_request_duration_ms_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95 延迟(ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}