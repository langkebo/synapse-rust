{
  "dashboard": {
    "id": null,
    "uid": "backend-services",
    "title": "后端服务监控",
    "tags": ["synapse-rust", "backend"],
    "timezone": "utc",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "15s",
    "panels": [
      {
        "id": 1,
        "title": "活跃用户数",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "synapse_active_users",
            "refId": "A",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 2,
        "title": "联合房间数",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "synapse_federated_rooms",
            "refId": "A",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 3,
        "title": "登录成功率",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(synapse_clientlogin_success_total[5m]) / rate(synapse_clientlogin_requests_total[5m]) * 100",
            "refId": "A",
            "legendFormat": "登录成功率"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 95},
                {"color": "red", "value": 90}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "消息发送速率",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(synapse_federation_txmsg_success_total[5m])",
            "refId": "A",
            "legendFormat": "发送消息"
          },
          {
            "expr": "rate(synapse_federation_txmsg_failure_total[5m])",
            "refId": "B",
            "legendFormat": "发送失败"
          }
        ]
      },
      {
        "id": 5,
        "title": "数据库连接池使用率",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "synapse_database_pool_used / synapse_database_pool_max * 100",
            "refId": "A",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 80},
                {"color": "red", "value": 90}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "事件持久化延迟",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 16},
        "targets": [
          {
            "expr": "synapse_persist_events_duration_seconds_sum / synapse_persist_events_duration_seconds_count",
            "refId": "A",
            "legendFormat": "平均延迟(秒)"
          }
        ]
      }
    ],
    "templating": {
      "list": []
    },
    "time": {"from": "now-1h", "to": "now"},
    "title": "后端服务监控"
  },
  "meta": {
    "folder": "synapse-rust",
    "slug": "backend-services",
    "version": 1
  }
}