{"dashboard": {"id": null, "uid": "matrix-load-test", "title": "矩阵负载测试", "tags": ["load-test", "matrix", "performance"], "timezone": "utc", "schemaVersion": 38, "version": 1, "refresh": "5s", "panels": [{"id": 1, "title": "并发用户数", "type": "stat", "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "k6_vus", "refId": "A", "legendFormat": "活跃 VU"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 10000}}, "title": "并发用户数"}, {"id": 2, "title": "请求速率", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}, "targets": [{"expr": "rate(matrix_request_count[5m])", "refId": "A", "legendFormat": "请求/秒"}], "fieldConfig": {"defaults": {"unit": "reqps"}}, "title": "请求速率"}, {"id": 3, "title": "登录延迟 P95", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "histogram_quantile(0.95, rate(matrix_login_duration_ms_bucket[5m]))", "refId": "A", "legendFormat": "P95"}, {"expr": "rate(matrix_login_duration_ms_sum[5m]) / rate(matrix_login_duration_ms_count[5m])", "refId": "B", "legendFormat": "均值"}], "fieldConfig": {"defaults": {"unit": "ms", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 500}, {"color": "red", "value": 1000}]}}}, "title": "登录延迟"}, {"id": 4, "title": "同步延迟 P95 (/sync 瓶颈)", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 6, "y": 8}, "targets": [{"expr": "rate(matrix_sync_duration_ms_sum[5m]) / rate(matrix_sync_duration_ms_count[5m])", "refId": "A", "legendFormat": "均值"}, {"expr": "rate(matrix_sync_duration_ms_count[5m]) > 0", "refId": "B", "legendFormat": "请求数"}], "fieldConfig": {"defaults": {"unit": "ms", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 1000}, {"color": "red", "value": 2000}]}}}, "title": "同步延迟"}, {"id": 5, "title": "消息延迟 P95", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "targets": [{"expr": "rate(matrix_message_duration_ms_sum[5m]) / rate(matrix_message_duration_ms_count[5m])", "refId": "A", "legendFormat": "均值"}], "fieldConfig": {"defaults": {"unit": "ms", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 500}, {"color": "red", "value": 1000}]}}}, "title": "消息延迟"}, {"id": 6, "title": "错误率", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 6, "y": 16}, "targets": [{"expr": "rate(matrix_error_count[5m]) / rate(matrix_request_count[5m])", "refId": "A", "legendFormat": "错误率"}], "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.05}]}}}, "title": "错误率"}, {"id": 7, "title": "CPU 使用率", "type": "stat", "gridPos": {"h": 8, "w": 6, "x": 0, "y": 24}, "targets": [{"expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A", "legendFormat": "{{instance}}"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 70}, {"color": "red", "value": 85}]}}, "title": "CPU 使用率"}, {"id": 8, "title": "内存使用", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 6, "y": 24}, "targets": [{"expr": "process_resident_memory_bytes{job=\"synapse-rust\"}", "refId": "A", "legendFormat": "RSS 内存"}], "fieldConfig": {"defaults": {"unit": "bytes"}}, "title": "内存使用"}, {"id": 9, "title": "数据库连接池", "type": "stat", "gridPos": {"h": 8, "w": 6, "x": 0, "y": 32}, "targets": [{"expr": "pool_utilization * 100", "refId": "A", "legendFormat": "使用率"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 80}, {"color": "red", "value": 90}]}}, "title": "数据库连接池"}, {"id": 10, "title": "速率限制拒绝率", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 6, "y": 32}, "targets": [{"expr": "rate(rate_limit_requests_rejected_total[5m]) / rate(rate_limit_requests_total[5m])", "refId": "A", "legendFormat": "拒绝率"}], "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 0.05}, {"color": "red", "value": 0.1}]}}, "title": "限流拒绝率"}], "templating": {"list": []}, "time": {"from": "now-1h", "to": "now"}, "title": "矩阵负载测试"}, "meta": {"folder": "synapse-rust", "slug": "matrix-load-test", "version": 1}}