# =============================================================================
# Synapse-Rust 联邦测试环境变量模板
# =============================================================================
# 用法: cp .env.federation-test.example .env.federation-test
# 用于本地多 homeserver 联邦测试场景（matrix.test / federation.test 等）
# =============================================================================

# =============================================================================
# 被测 homeserver 配置（synapse-app）
# =============================================================================
SERVER_NAME=matrix.test
PUBLIC_BASEURL=https://matrix.test
FEDERATION_SERVER_NAME=matrix.test

# 数据库（被测）
POSTGRES_USER=synapse
POSTGRES_PASSWORD=__CHANGE_ME_federation_test_postgres__
POSTGRES_DB=synapse
FEDERATION_TEST_DB_PASSWORD=__CHANGE_ME_same_as_postgres__

# Redis（被测）
REDIS_PASSWORD=__CHANGE_ME_federation_test_redis__

# 密钥（本地联邦测试用）
ADMIN_SHARED_SECRET=__CHANGE_ME_admin_shared_secret__
JWT_SECRET=__CHANGE_ME_jwt_secret__
REGISTRATION_SHARED_SECRET=__CHANGE_ME_registration_secret__
SECRET_KEY=__CHANGE_ME_secret_key__
MACAROON_SECRET=__CHANGE_ME_macaroon_secret__
FORM_SECRET=__CHANGE_ME_form_secret__
TOKEN_HASH_SECRET=__CHANGE_ME_token_hash_secret__
FEDERATION_MASTER_KEY=__CHANGE_ME_federation_master_key__
FEDERATION_ALLOW_PLAINTEXX=false
FEDERATION_SIGNING_KEY=disabled
FEDERATION_KEY_ID=ed25519:auto
WORKER_REPLICATION_SECRET=__CHANGE_ME_worker_replication__

# 联邦端口
FEDERATION_PORT=8448
FEDERATION_PORT_2=8449

# =============================================================================
# 联邦测试 homeserver 配置（第二个 homeserver，用于测试 federation）
# =============================================================================
FEDERATION_SERVER_NAME_2=federation.test
FEDERATION_PUBLIC_BASEURL_2=https://federation.test

# 数据库（第二个 homeserver）
POSTGRES_USER_2=federation_test
POSTGRES_PASSWORD_2=__CHANGE_ME_federation_test_2_postgres__
POSTGRES_DB_2=federation_test
FEDERATION_TEST_DB_PASSWORD_2=__CHANGE_ME_federation_test_2__

# Redis（第二个 homeserver）
REDIS_PASSWORD_2=__CHANGE_ME_federation_test_2_redis__

# 密钥（第二个 homeserver）
ADMIN_SHARED_SECRET_2=__CHANGE_ME_admin_shared_secret_2__
JWT_SECRET_2=__CHANGE_ME_jwt_secret_2__
REGISTRATION_SHARED_SECRET_2=__CHANGE_ME_registration_secret_2__
SECRET_KEY_2=__CHANGE_ME_secret_key_2__
MACAROON_SECRET_2=__CHANGE_ME_macaroon_secret_2__
FORM_SECRET_2=__CHANGE_ME_form_secret_2__
TOKEN_HASH_SECRET_2=__CHANGE_ME_token_hash_secret_2__
FEDERATION_MASTER_KEY_2=__CHANGE_ME_federation_master_key_2__
FEDERATION_ALLOW_PLAINTEXT_2=false
FEDERATION_SIGNING_KEY_2=disabled
FEDERATION_KEY_ID_2=ed25519:auto

# 联邦端口（第二个 homeserver）
FEDERATION_PORT_2_server=8449

# =============================================================================
# 共享测试密钥（两个 homeserver 之间的互信）
# =============================================================================
FEDERATION_TEST_SHARED_SECRET_1=__CHANGE_ME_shared_secret_1__
FEDERATION_TEST_SHARED_SECRET_2=__CHANGE_ME_shared_secret_2__

# =============================================================================
# SSL 证书（本地测试用）
# =============================================================================
SSL_CERT=cert.pem
SSL_KEY=key.pem

# =============================================================================
# 日志与调试
# =============================================================================
RUST_LOG=debug
# TRUST_FORWARDED_HEADERS=true
