# =============================================================================
# Synapse-Rust 生产部署环境变量模板
# =============================================================================
# 用法: 复制本文件为 .env 并填入实际值
#       cp .env.example .env
#
# 密钥生成:  ./docker/deploy/scripts/generate-secrets.sh all
#            或: openssl rand -hex 32
# =============================================================================
#
# 任何标记为 __CHANGE_ME__ 的变量都必须在部署前替换为强随机值。
# 切勿将真实 .env 文件提交到版本控制（已 .gitignore）。

# =============================================================================
# 项目标识
# =============================================================================
COMPOSE_PROJECT_NAME=synapse

# =============================================================================
# 服务器配置
# =============================================================================
SERVER_NAME=matrix.test
PUBLIC_BASEURL=https://matrix.test

# =============================================================================
# CORS 配置
# =============================================================================
ALLOWED_ORIGINS=http://localhost:8008,http://127.0.0.1:8008,http://localhost:6130,http://127.0.0.1:6130,http://localhost:8080,http://127.0.0.1:8080,https://localhost:8443,https://127.0.0.1:8443,https://element.test,https://matrix.test,tauri://localhost,https://tauri.localhost,vector://vector
CORS_ORIGIN_PATTERN='^https?://(localhost|127\.0\.0\.1|element\.test|matrix\.test)(:[0-9]+)?$'

# =============================================================================
# 数据库配置（PostgreSQL）
# =============================================================================
POSTGRES_USER=synapse
POSTGRES_PASSWORD=__CHANGE_ME_generate_with_generate_secrets_postgres__
POSTGRES_DB=synapse
DB_USER=synapse
DB_NAME=synapse
DB_PASSWORD=__CHANGE_ME_same_as_POSTGRES_PASSWORD__

# =============================================================================
# Redis 配置
# =============================================================================
REDIS_PASSWORD=__CHANGE_ME_generate_with_generate_secrets_redis__
REDIS_MAX_MEMORY=256mb
REDIS_EVICTION_POLICY=allkeys-lru
REDIS_KEY_PREFIX=synapse:

# =============================================================================
# 安全密钥（必须全部替换）
# 生成方法: ./docker/deploy/scripts/generate-secrets.sh all
# 或: openssl rand -hex 32 (各 64 字符)
# =============================================================================
ADMIN_SHARED_SECRET=__CHANGE_ME_generate_with_generate_secrets_admin__
JWT_SECRET=__CHANGE_ME_generate_with_generate_secrets_jwt__
REGISTRATION_SHARED_SECRET=__CHANGE_ME_generate_with_generate_secrets_registration__
SECRET_KEY=__CHANGE_ME_generate_with_generate_secrets_secret__
MACAROON_SECRET=__CHANGE_ME_generate_with_generate_secrets_macaroon__
FORM_SECRET=__CHANGE_ME_generate_with_generate_secrets_form__
TOKEN_HASH_SECRET=__CHANGE_ME_must_be_at_least_32_bytes_hex__
WORKER_REPLICATION_SECRET=__CHANGE_ME_for_worker_replication__

# 联邦签名密钥（生产环境必须）
# 32 字节十六进制；用于加密存储联邦签名密钥
FEDERATION_MASTER_KEY=__CHANGE_ME_openssl_rand_hex_32__
FEDERATION_ALLOW_PLAINTEXT=false
FEDERATION_SIGNING_KEY=disabled
FEDERATION_KEY_ID=ed25519:auto

# Megolm E2EE 加密密钥路径（首次启动自动生成）
SYNAPSE_MEGOLM_ENCRYPTION_KEY_PATH=/app/data/megolm.key
SYNAPSE__SERVER__MEGOLM_ENCRYPTION_KEY_PATH=/app/data/megolm.key

# =============================================================================
# 镜像配置
# =============================================================================
# 本地构建: synapse-rust:local
# 远程镜像: docker.io/yourname/synapse-rust:latest
SYNAPSE_IMAGE=synapse-rust:local
SYNAPSE_IMAGE_TAG=local
SYNAPSE_PULL_POLICY=never
DOCKER_CARGO_FEATURE_ARGS=--features server,core-private-chat,widgets,external-services,voice-extended,cas-sso,saml-sso,friends --no-default-features
DOCKER_CARGO_BUILD_JOBS=2

# =============================================================================
# 端口配置
# =============================================================================
SYNAPSE_PORT=8008
HTTP_PORT=80
HTTPS_PORT=443
FEDERATION_PORT=8448
PROMETHEUS_PORT=9090
DB_EXPOSE_PORT=5432
REDIS_EXPOSE_PORT=6379

# =============================================================================
# 资源限制
# =============================================================================
POSTGRES_CPU_LIMIT=1.5
POSTGRES_MEMORY_LIMIT=1536m
POSTGRES_PIDS_LIMIT=256
REDIS_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=512m
REDIS_PIDS_LIMIT=128
SYNAPSE_CPU_LIMIT=2.0
SYNAPSE_MEMORY_LIMIT=4096m
SYNAPSE_PIDS_LIMIT=512
NGINX_CPU_LIMIT=0.5
NGINX_MEMORY_LIMIT=256m
NGINX_PIDS_LIMIT=128
MIGRATOR_CPU_LIMIT=1.0
MIGRATOR_MEMORY_LIMIT=1024m
MIGRATOR_PIDS_LIMIT=128

# =============================================================================
# jemalloc profiler（内存泄漏诊断；定位后删本行即可关闭）
# =============================================================================
MALLOC_CONF=prof:true,prof_active:true,lg_prof_sample:19,lg_prof_interval:28,prof_prefix:/app/data/jeprof.out,prof_final:true

# =============================================================================
# 数据库连接池
# =============================================================================
SYNAPSE__DATABASE__POOL_SIZE=20
SYNAPSE__DATABASE__MAX_SIZE=50
SYNAPSE__DATABASE__MIN_IDLE=10
SYNAPSE__DATABASE__CONNECTION_TIMEOUT=60

# =============================================================================
# 数据库迁移
# =============================================================================
RUN_MIGRATIONS=true
VERIFY_SCHEMA=true
STOP_ON_MIGRATION_FAILURE=true
DB_WAIT_ATTEMPTS=30
DB_WAIT_INTERVAL=2
MIGRATION_TIMEOUT=300
SYNAPSE_ENABLE_RUNTIME_DB_INIT=true
SYNAPSE_SKIP_SCHEMA_CHECK=false
SYNAPSE_SKIP_DB_INIT=false
ENABLED_EXTENSIONS=core-private-chat
ROLLBACK_ON_FAILURE=true

# =============================================================================
# SSL 证书配置
# =============================================================================
# 证书和私钥文件放在 docker/deploy/ssl/ 目录下
# 推荐用 mkcert 生成受信任的本地证书: https://github.com/FiloSottile/mkcert
SSL_CERT=cert.pem
SSL_KEY=key.pem

# =============================================================================
# 监控（OpenTelemetry OTLP）
# =============================================================================
OTLP_ENDPOINT=http://127.0.0.1:4317
RUST_LOG=info

# =============================================================================
# VoIP / TURN
# =============================================================================
# 必须与本地 coturn 的 static-auth-secret 一致
# 默认 dev-turn-secret 仅用于本地开发，生产环境必须替换
TURN_SHARED_SECRET=__CHANGE_ME_match_coturn_static_auth_secret__
TURN_HOST=127.0.0.1
TURN_PORT=3478
TURNS_PORT=5349

# =============================================================================
# Worker 二进制
# =============================================================================
SYNAPSE_WORKER_METRICS_HOST=0.0.0.0
SYNAPSE_WORKER_METRICS_PORT=9091
SYNAPSE_WORKER_METRICS_TOKEN=__CHANGE_ME_for_worker_metrics_scrape__
SYNAPSE_HEALTHCHECK_BASE_URL=http://synapse-app:8008
SYNAPSE_HEALTHCHECK_HOST=0.0.0.0
SYNAPSE_HEALTHCHECK_PORT=8008

# =============================================================================
# 可选 — 行为调优（按需取消注释）
# =============================================================================
# SYNAPSE__SERVER__SUPPRESS_R0_DEPRECATION_WARNING=true
# SYNAPSE__SERVER__SUPPRESS_VENDOR_ENDPOINT_WARNING=true
# SYNAPSE_ENABLE_GLOBAL_MAINTENANCE_TASKS=true
# SYNAPSE_PASSWORD_HASH_POOL_MAX_CONCURRENT=8
# SYNAPSE_PASSWORD_HASH_POOL_THREAD_POOL_SIZE=4
# SYNAPSE_PASSWORD_HASH_POOL_QUEUE_SIZE=256
# SYNAPSE_PASSWORD_HASH_POOL_HASH_TIMEOUT_MS=2000
# HSTS_INCLUDE_SUB_DOMAINS=true
# HSTS_MAX_AGE_SECS=31536000
# CORS_MAX_AGE=86400
# TRUST_FORWARDED_HEADERS=true
# MEGOLM_SESSION_MAX_AGE_DAYS=14
# E2EE_DUAL_WRITE=false
# E2EE_INTEROP=false
# UPDATE_ROUTE_LEDGER_SNAPSHOTS=false

# =============================================================================
# 可选 — 联邦测试（CI 用，本地开发一般不需要）
# =============================================================================
# FEDERATION_SERVER_NAME=federation.test
# FEDERATION_PORT_2=8449

# =============================================================================
# 部署前自检清单
# =============================================================================
# [ ] 1. cp .env.example .env
# [ ] 2. ./docker/deploy/scripts/generate-secrets.sh all    # 生成所有密钥
# [ ] 3. 编辑 .env: SERVER_NAME / PUBLIC_BASEURL / TURN_SHARED_SECRET
# [ ] 4. docker/deploy/ssl/ 下放入 cert.pem + key.pem (mkcert 生成)
# [ ] 5. echo "127.0.0.1 matrix.test" | sudo tee -a /etc/hosts
# [ ] 6. ./docker/deploy/deploy.sh --all
