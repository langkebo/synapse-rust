.tmp_*.py
analyze_results.py
prepare_test_accounts.py
register_test_accounts.py

# gstack 计划文件（自动化工作流生成）
docs/superpowers/plans/

# 测试工具链依赖（由 npm install 重建，不应入仓）
tests/element-web-harness/node_modules/
# e2e/interop 运行产物（Playwright 截图 + HTML dump，实测 210 文件 / 266 MB）
tests/element-web-harness/artifacts/

