#!/bin/bash
# pre-push guard: CI 同款 clippy（含测试代码编译） + cargo-deny advisories + cargo-machete
#
# 启用（每个 clone 一次）：  git config core.hooksPath .githooks
# 绕过：                    git push --no-verify
#
# ── 为什么"编译关卡"放在 pre-push，而不是 pre-commit ──────────────────────────
#   全工作区 clippy 需要数分钟，塞进 pre-commit 必然被所有人用 `--no-verify` 绕过；
#   push 的频率低得多，几分钟可以接受。
#   而 2026-09-22 反复出现的缺陷**不是**格式问题（那个 pre-commit 已经能拦住），
#   而是"新增测试从未在 `--all-features` 下编译过"：两轮清理、相隔数小时、不同文件、
#   同一模式，每次都让 CI 的 blocking lib 批次直接 exit 101，而本地毫无察觉。
#   pre-commit 管不了编译，所以必须在这里设一道能编译的关卡。
#
# 判据（红 → 绿，同一命令）：
#   * 红：`main` 4db39228 实跑本命令 exit 101（`synapse-storage` lib test 5 处 E0308）；
#   * 绿：修复后同一命令 exit 0。
#   详见 docs/audit/FULL_SUITE_ISOLATION_VERIFY_2026-09-22.md §7.6 / §7.7。
set -uo pipefail

BYPASS_HINT="  绕过：git push --no-verify（仅紧急情况）"

# ── Stage 0（阻断，最便宜先跑）：方案文档的章节棘轮 ────────────────────────────
# 为什么在 pre-push 也放一份：`docs/audit/UPSTREAM_CHANGELOG_ALIGNMENT_PLAN_2026-10-13.md`
# 会被**宿主 app 进程**用一份陈旧的缓存副本覆盖（2026-10-14 实测 5 次），每次都整段吞掉
# 最新章节。pre-commit 里已有该步骤，但（a）它可以被 `--no-verify` 绕过一次就永久生效、
# （b）覆盖发生在提交之后（实测有一次在提交后 12 分 25 秒）—— 也就是说**已经提交过的内容
# 也可能被工作区的那份覆盖"回退"**。push 是最后一道闸门，且该检查 ~30ms，没有理由不做。
# 判据与恢复步骤见该文档 §11.9 / §11.12。
if [ ! -f scripts/ci/check_plan_doc_sections.py ]; then
  echo ""
  echo "❌ push 被拦下：找不到方案文档章节棘轮脚本（fail-closed）。"
  echo "   被删除/改名的守卫脚本不能静默放行。"
  echo "   恢复：git checkout -- scripts/ci/check_plan_doc_sections.py"
  echo "$BYPASS_HINT"
  exit 1
fi
if ! python3 scripts/ci/check_plan_doc_sections.py; then
  echo ""
  echo "❌ push 被拦下：方案文档有章节被吞掉了（基线或 HEAD 里有、工作区里没有）。"
  echo "   恢复：git checkout -- docs/audit/UPSTREAM_CHANGELOG_ALIGNMENT_PLAN_2026-10-13.md"
  echo "$BYPASS_HINT"
  exit 1
fi
echo "✅ 方案文档章节棘轮通过（基线 + 对照 HEAD）"

# ── Stage 1（阻断）：clippy，作用域与 ci.yml 的 blocking 矩阵一致 ──────────────
# `--workspace` + `--all-targets` 二者缺一都会漏掉 member crate 或测试代码（历史上都漏过）。
# 只跑 `--all-features` 这一档：feature 只增不减，它是默认档的超集；默认档独有的
# `not(feature = "…")` 分支仍由 CI 每次 push 覆盖。
if ! command -v cargo >/dev/null 2>&1; then
  echo ""
  echo "❌ push 被拦下：未找到 cargo（fail-closed）。"
  echo "   安装 Rust 工具链：https://rustup.rs"
  echo "$BYPASS_HINT"
  exit 1
fi
if ! SQLX_OFFLINE=true cargo clippy --workspace --all-targets --features test-utils \
    --all-features --locked -- -D warnings; then
  echo ""
  echo "❌ push 被拦下：clippy / 编译未通过（CI 的 blocking lib 批次会同样失败）。"
  echo "$BYPASS_HINT"
  exit 1
fi
echo "✅ clippy --workspace --all-targets --all-features 通过"

# ── Stage 2（阻断）：cargo-deny advisories ─────────────────────────────────────
# 代理透传：cargo-deny 用 reqwest 拉取 advisory-db，只认 HTTPS_PROXY/HTTP_PROXY，
# 不读取 git 的 http.proxy 配置——于是会出现「git 能走代理、cargo-deny 却拉取失败」。
# 这里按需注入，保持代理可选：已有 HTTPS_PROXY 则沿用；否则回退到 git 配置的代理；
# 两者都没有则不设代理（行为与原先一致）。
if ! command -v cargo-deny >/dev/null 2>&1; then
  echo ""
  echo "❌ push 被拦下：未安装 cargo-deny（fail-closed）。"
  echo "   安装：cargo install cargo-deny"
  echo "$BYPASS_HINT"
  exit 1
fi
if [ -z "${HTTPS_PROXY:-}${https_proxy:-}" ]; then
  GIT_PROXY="$(git config --get http.proxy 2>/dev/null || true)"
  if [ -n "${GIT_PROXY:-}" ]; then
    export HTTPS_PROXY="$GIT_PROXY" HTTP_PROXY="$GIT_PROXY"
    echo "ℹ️  已按 git http.proxy=$GIT_PROXY 注入 HTTPS_PROXY（供 cargo-deny 拉取 advisory-db）"
  fi
fi
if ! cargo deny check advisories; then
  echo ""
  echo "❌ push 被拦下：cargo-deny advisories 未通过（见上方输出）。"
  echo "$BYPASS_HINT"
  exit 1
fi
echo "✅ cargo-deny advisories 通过"

# ── Stage 3（阻断）：cargo-machete 未使用依赖 ─────────────────────────────────
# 依赖只增不减会持续放大编译时间与供应链面。machete 静态扫描各 crate 的 Cargo.toml，
# 报告声明却未被源码引用的依赖（含 `use`/路径引用判定，能识别宏与 derive）。误报可
# 通过 `[package.metadata.cargo-machete] ignored` 白名单处理，而不是长期留痕。
if ! command -v cargo-machete >/dev/null 2>&1; then
  echo ""
  echo "❌ push 被拦下：未安装 cargo-machete（fail-closed）。"
  echo "   安装：cargo install cargo-machete"
  echo "$BYPASS_HINT"
  exit 1
fi
if ! cargo machete; then
  echo ""
  echo "❌ push 被拦下：存在未被引用的依赖（cargo-machete）。"
  echo "   处理：删除声明、移到正确 crate，或加入 [package.metadata.cargo-machete] ignored。"
  echo "$BYPASS_HINT"
  exit 1
fi
echo "✅ cargo-machete 未发现未使用依赖"
