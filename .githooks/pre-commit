#!/bin/bash
# pre-commit guard: CI 同名门禁一次跑全（preflight）+ clippy（opt-in）+ advisory cargo-audit
#
# 启用（每个 clone 一次）：  git config core.hooksPath .githooks
# 紧急绕过：                git commit --no-verify
#
# ── 为什么跑 scripts/quality/preflight.sh，而不是只跑 fmt 棘轮 ──
#   2026-10-02 实测两次"红进主干"，成因都不是"改错"而是"跑漏门禁"：
#     * 416ece3c8 漏 `cargo fmt`（当时提交用了 --no-verify，把本可拦住它的 Stage 1 绕过了）；
#     * cf845cb35 漏 `ruff format`（**旧 Stage 1 根本不覆盖 Python**，即便不绕过也拦不住）。
#   故把 CI 的同名入口（fmt 棘轮 + scripts/quality/format_check.sh + 逐文件 aspell/markdownlint
#   + 契约 gate）在提交前一次跑全 —— 本地判绿与 CI 判绿是同一个实现（AGENTS.md 铁律 2）。
#
# ⚠️ preflight 检查的是**整棵树 / 改动集**（含未跟踪新文件），不是"仅暂存内容"：这正是 CI 语义。
#    它内部的 `cargo fmt --all` 会直接改工作区文件 —— 若它改动了文件，说明暂存内容已过期，
#    本 hook 会拦下并要求重新 `git add`（否则会把未格式化的暂存快照提交进去）。
set -uo pipefail

if [ ! -x ./scripts/quality/preflight.sh ]; then
  echo "❌ 找不到可执行的 ./scripts/quality/preflight.sh —— 拒绝在无法执行门禁时提交。"
  echo "   （门禁绝不允许因'工具缺失'而静默通过；紧急情况用 git commit --no-verify）"
  exit 1
fi

# ── Stage 1（阻断）：CI 同名门禁（preflight；clippy 按需） ────────────────────
if [ "${SYNAPSE_PRECOMMIT_CLIPPY:-0}" = "1" ]; then
  preflight_args="--clippy"
else
  preflight_args=""
  echo "ℹ️  已跳过 clippy（设 SYNAPSE_PRECOMMIT_CLIPPY=1 追加两档；CI 每次 push 跑两档矩阵）"
fi

# shellcheck disable=SC2086
if ! bash ./scripts/quality/preflight.sh $preflight_args; then
  echo ""
  echo "❌ 提交被拦下：preflight 有失败项（见上面 FAIL 行）。"
  echo "   修复后重新 git add；紧急绕过：git commit --no-verify"
  exit 1
fi

# preflight 里的 `cargo fmt --all` 可能刚改过工作区文件 ⇒ 暂存快照过期，必须重新 add。
#
# ⚠️ 判据必须取「**已暂存 ∩ 未暂存**」的交集，而不是「未暂存集合非空」：
#   要拦的只有一种情况 —— preflight 改了**已进入本次提交**的文件，于是"提交的内容"
#   不再是门禁刚判绿的那份快照（提交进去的会是未格式化的旧快照，CI 的 fmt 棘轮随后判红）。
#   旧实现在多写者仓库里会误伤：**任何人**留在工作区的未提交文件（含他人 WIP）都让
#   所有提交被拦，绕过只剩 `--no-verify`，而那会把本 hook 的全部门禁一并绕掉
#   （正是文件头记录的两次"红进主干"的成因）。仅未暂存的他人文件不构成暂存快照过期。
stale_snapshot="$(comm -12 \
  <(git -c core.quotePath=false diff --name-only | sort) \
  <(git -c core.quotePath=false diff --cached --name-only | sort))"
if [ -n "$stale_snapshot" ]; then
  echo ""
  echo "❌ preflight 修改了**已暂存**的文件（多半是 cargo fmt）—— 暂存快照已过期，请重新 git add 后再提交："
  printf '%s\n' "$stale_snapshot" | sed 's/^/     /'
  echo "   （仅存在于工作区、未进入本次提交的文件不会被本检查拦下）"
  exit 1
fi

# ── Stage 2（仅提示，不阻断）：cargo-audit ───────────────────────────────────
if command -v cargo-audit >/dev/null 2>&1; then
  cargo audit --quiet 2>/dev/null || true
else
  echo "tip: install cargo-audit for local security checks (cargo install cargo-audit)"
fi
