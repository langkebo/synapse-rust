{
  "dashboard": {
    "id": null,
    "title": "Synapse-Rust - Business Metrics",
    "description": "Business-level metrics for Synapse-Rust Matrix homeserver - tracks user growth, engagement, encryption adoption, and operational KPIs",
    "version": 1,
    "tags": ["synapse", "matrix", "business", "kpi"],
    "timezone": "browser",
    "schemaVersion": 39,
    "links": [],
    "refresh": "1m",
    "panels": [
      {
        "id": 1,
        "title": "活跃用户趋势",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(increase(auth_success[1h]))",
            "legendFormat": "每小时活跃用户"
          },
          {
            "expr": "sum(increase(auth_success[24h])) / 24",
            "legendFormat": "日均活跃用户 (移动平均)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 2,
        "title": "房间增长趋势",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(increase(room_operations_total{operation=\"create\",outcome=\"success\"}[1h]))",
            "legendFormat": "每小时新增房间"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 3,
        "title": "消息发送量 (分加密状态)",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(increase(messages_sent_total{encryption=\"true\"}[1h]))",
            "legendFormat": "加密消息"
          },
          {
            "expr": "sum(increase(messages_sent_total{encryption=\"false\"}[1h]))",
            "legendFormat": "明文消息"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 4,
        "title": "端到端加密覆盖率",
        "type": "gauge",
        "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 },
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(messages_sent_total{encryption=\"true\"}[1h])) / sum(rate(messages_sent_total[1h])) * 100",
            "legendFormat": "E2EE 覆盖率"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "red" },
                { "value": 50, "color": "yellow" },
                { "value": 70, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "消息发送延迟分布",
        "type": "heatmap",
        "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(message_delivery_latency_seconds_bucket[5m])) by (le)",
            "format": "heatmap",
            "legendFormat": "{{le}}"
          }
        ]
      },
      {
        "id": 6,
        "title": "房间操作成功率 (按类型)",
        "type": "piechart",
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(room_operations_total{outcome=\"success\"}[5m]))",
            "legendFormat": "成功"
          },
          {
            "expr": "sum(rate(room_operations_total{outcome=\"error\"}[5m]))",
            "legendFormat": "失败"
          },
          {
            "expr": "sum(rate(room_operations_total{outcome=\"forbidden\"}[5m]))",
            "legendFormat": "拒绝"
          }
        ]
      },
      {
        "id": 7,
        "title": "数据库查询错误率",
        "type": "table",
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(db_query_errors[5m]))",
            "format": "table",
            "instant": true,
            "legendFormat": "错误/秒"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true },
              "indexByName": {},
              "renameByName": {
                "Value": "错误/秒"
              }
            }
          }
        ]
      },
      {
        "id": 8,
        "title": "缓存命中率 (按类型)",
        "type": "bargauge",
        "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(cache_operations_total{result=\"hit\"}[5m])) by (cache_type) / sum(rate(cache_operations_total[5m])) by (cache_type) * 100",
            "legendFormat": "{{cache_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 9,
        "title": "E2EE 密钥交换延迟分布",
        "type": "histogram",
        "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(e2ee_handshake_duration_seconds_bucket[5m])) by (le)",
            "format": "heatmap",
            "legendFormat": "{{le}}"
          }
        ]
      },
      {
        "id": 10,
        "title": "Federation 成功率 (按目标服务器)",
        "type": "table",
        "gridPos": { "x": 0, "y": 32, "w": 24, "h": 8 },
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(federation_operations_total{result=\"success\"}[5m])) by (target_server) / sum(rate(federation_operations_total[5m])) by (target_server) * 100",
            "format": "table",
            "instant": true,
            "legendFormat": "{{target_server}}"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true },
              "indexByName": {},
              "renameByName": {
                "Value": "成功率 (%)",
                "target_server": "目标服务器"
              }
            }
          }
        ]
      },
    {
      "id": 11,
      "title": "Stream 位置（per-stream）",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "synapse_storage_stream_current_position", "legendFormat": "{{stream}}" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "description": "每个 stream 的当前最大位置（events/to_device/device_lists/sliding_sync/quarantined_media）；长期不推进=该 stream 写路径卡住。刷新周期 30s。" },
        "overrides": []
      }
    }
  ],
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refresh": 1,
          "query": "label_values(up, instance)",
          "includeTime": false,
          "multi": true,
          "current": { "text": "All", "value": "$__all" }
        },
        {
          "name": "room_type",
          "type": "custom",
          "options": ["public", "private", "space"],
          "current": { "text": "All", "value": "$__all" }
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "部署标记",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "enable": true
        }
      ]
    }
  },
  "overwrite": true
}
