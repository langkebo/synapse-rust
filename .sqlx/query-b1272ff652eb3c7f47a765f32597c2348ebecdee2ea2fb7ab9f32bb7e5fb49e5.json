{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, task_id, task_type,\n                      COALESCE(task_data, '{}'::jsonb) AS \"task_data!\",\n                      assigned_worker_id,\n                      status, priority,\n                      created_ts, assigned_ts,\n                      completed_ts, result,\n                      error_message\n            FROM worker_task_assignments\n            WHERE status = 'pending'\n            ORDER BY priority DESC, created_ts ASC\n            LIMIT $1\n            ",
