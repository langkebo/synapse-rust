  "query": "\n            SELECT job_name AS \"job_name!\", job_type AS \"job_type!\", description, table_name, column_name,\n                   status AS \"status!\", progress AS \"progress!\", total_items AS \"total_items!\",\n                   processed_items AS \"processed_items!\", created_ts, started_ts, completed_ts, updated_ts,\n                   error_message, retry_count AS \"retry_count!\", max_retries AS \"max_retries!\",\n                   batch_size AS \"batch_size!\", sleep_ms AS \"sleep_ms!\", depends_on, metadata\n            FROM background_updates WHERE status = $1 ORDER BY created_ts ASC, id ASC\n            ",
