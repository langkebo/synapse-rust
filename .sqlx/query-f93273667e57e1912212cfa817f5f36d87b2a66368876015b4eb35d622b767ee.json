  "db_name": "PostgreSQL",
  "query": "\n            UPDATE registration_tokens SET\n                description = COALESCE($2, description),\n                max_uses = COALESCE($3, max_uses),\n                is_enabled = COALESCE($4, is_enabled),\n                expires_at = COALESCE($5, expires_at)\n            WHERE id = $1\n            RETURNING id, token, token_type AS \"token_type!\", description,\n                      max_uses AS \"max_uses!\", uses_count AS \"uses_count!\",\n                      is_used AS \"is_used!\", is_enabled AS \"is_enabled!\",\n                      expires_at, created_by, created_ts, updated_ts, last_used_ts,\n                      allowed_email_domains, allowed_user_ids, auto_join_rooms,\n                      display_name, email\n            ",
