  "query": "\n                SELECT space_id, user_id, membership, joined_ts, updated_ts, left_ts, inviter\n                FROM space_members\n                WHERE space_id = $1 AND membership = 'join' AND (joined_ts > $2 OR (joined_ts = $2 AND user_id > $3))\n                ORDER BY joined_ts ASC, user_id ASC\n                LIMIT $4\n                ",
