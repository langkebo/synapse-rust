{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT event_id, room_id, sender, event_type, content, state_key,\n                   origin_server_ts, depth, origin\n            FROM events\n            WHERE room_id = $1 AND event_id = ANY($2)\n            ORDER BY origin_server_ts ASC\n            LIMIT $3\n            ",
