  "query": "\n                SELECT id, user_id, room_id, media_id, content_type, duration_ms, size_bytes, created_ts\n                FROM voice_usage_stats\n                WHERE room_id = $1 AND created_ts < $2\n                ORDER BY created_ts DESC, id DESC\n                LIMIT $3\n                ",
