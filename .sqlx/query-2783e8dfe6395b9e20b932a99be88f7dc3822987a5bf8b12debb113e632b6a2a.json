{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE application_services SET\n                url = COALESCE($2, url),\n                description = COALESCE($3, description),\n                is_rate_limited = COALESCE($4, is_rate_limited),\n                protocols = COALESCE($5::text[], protocols),\n                is_enabled = COALESCE($6, is_enabled),\n                api_key = COALESCE($7, api_key),\n                config = COALESCE($8::jsonb, config),\n                updated_ts = $9\n            WHERE as_id = $1\n            RETURNING id, as_id, url, as_token, hs_token, sender_localpart,\n                is_enabled AS \"is_enabled!\", is_rate_limited AS \"is_rate_limited!\",\n                protocols AS \"protocols!\", namespaces AS \"namespaces!\",\n                created_ts, updated_ts, description, api_key, config\n            ",
