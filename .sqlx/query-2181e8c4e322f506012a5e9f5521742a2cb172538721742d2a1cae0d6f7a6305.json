{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT e.revision, e.event_id, e.event_type, e.is_sticky,\n                   e.sticky_duration_ms, e.expires_at\n            FROM room_sticky_events e\n            WHERE e.room_id = $1\n              AND e.revision > $2\n              AND (e.user_id = $3 OR e.user_id LIKE '%:' || $3)\n            ORDER BY e.revision ASC\n            LIMIT $4\n            ",
