  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                session_id,\n                user_id,\n                device_id,\n                sender_key,\n                receiver_key,\n                serialized_state,\n                message_index,\n                created_ts,\n                last_used_ts,\n                expires_at\n            FROM olm_sessions\n            WHERE user_id = $1 AND device_id = $2 AND sender_key = $3\n            ORDER BY last_used_ts DESC\n            LIMIT 1\n            ",
