  "query": "\n            SELECT\n                user_id,\n                expiration_at,\n                last_check_at,\n                renewal_token,\n                is_valid AS \"is_valid!\",\n                created_ts,\n                COALESCE(updated_ts, created_ts) AS \"updated_ts!\",\n                NULL::BIGINT AS \"renewal_token_ts\"\n            FROM account_validity\n            WHERE user_id = $1\n            ",
