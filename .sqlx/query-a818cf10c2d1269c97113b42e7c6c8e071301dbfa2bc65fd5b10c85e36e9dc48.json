  "query": "\n                SELECT id, user_id, device_id, operation, key_id, room_id, details, ip_address, created_ts\n                FROM e2ee_audit_log\n                WHERE user_id = $1 AND (created_ts < $2 OR (created_ts = $2 AND id < $3))\n                ORDER BY created_ts DESC, id DESC\n                LIMIT $4\n                ",
