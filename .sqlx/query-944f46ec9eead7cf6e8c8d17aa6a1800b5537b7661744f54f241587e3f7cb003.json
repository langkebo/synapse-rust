{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE application_service_transactions\n            SET retry_count = retry_count + 1, last_error = $3, sent_ts = $4\n            WHERE as_id = $1 AND (txn_id = $2 OR transaction_id = $2)\n            RETURNING\n                id,\n                as_id,\n                txn_id,\n                transaction_id,\n                events AS \"events!\",\n                sent_ts,\n                completed_ts,\n                retry_count,\n                last_error\n            ",
