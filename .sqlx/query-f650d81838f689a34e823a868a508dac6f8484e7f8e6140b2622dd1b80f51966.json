{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, user_id, device_id, device_data, algorithm, account, created_ts, updated_ts, expires_at\n            FROM dehydrated_devices\n            WHERE user_id = $1\n              AND (expires_at IS NULL OR expires_at > $2)\n            ORDER BY updated_ts DESC, id DESC\n            LIMIT 1\n            ",
