{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                user_id,\n                COALESCE(backup_id_text, version::text) AS \"backup_id!\",\n                version,\n                algorithm,\n                auth_key,\n                mgmt_key,\n                auth_data AS backup_data,\n                etag\n            FROM key_backups\n            WHERE user_id = $1\n            ORDER BY version DESC\n            LIMIT 1\n            ",
