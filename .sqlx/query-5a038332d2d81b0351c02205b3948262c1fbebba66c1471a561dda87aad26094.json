{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                kb.user_id,\n                COALESCE(kb.backup_id_text, kb.version::text) AS \"backup_id!\",\n                bk.room_id,\n                bk.session_id,\n                bk.first_message_index,\n                bk.forwarded_count,\n                bk.is_verified,\n                bk.session_data\n            FROM backup_keys bk\n            JOIN key_backups kb ON kb.backup_id = bk.backup_id\n            WHERE kb.user_id = $1\n            ",
