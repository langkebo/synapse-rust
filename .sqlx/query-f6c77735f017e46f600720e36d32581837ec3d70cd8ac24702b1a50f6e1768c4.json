  "db_name": "PostgreSQL",
  "query": "\n            UPDATE background_updates SET\n                status = $2,\n                started_ts = COALESCE($3, started_ts),\n                completed_ts = COALESCE($4, completed_ts),\n                updated_ts = $5\n            WHERE update_name = $1\n            RETURNING\n                job_name AS \"job_name!\",\n                job_type AS \"job_type!\",\n                description,\n                table_name,\n                column_name,\n                status AS \"status!\",\n                progress AS \"progress!\",\n                total_items AS \"total_items!\",\n                processed_items AS \"processed_items!\",\n                created_ts,\n                started_ts,\n                completed_ts,\n                updated_ts,\n                error_message,\n                retry_count AS \"retry_count!\",\n                max_retries AS \"max_retries!\",\n                batch_size AS \"batch_size!\",\n                sleep_ms AS \"sleep_ms!\",\n                depends_on,\n                metadata\n            ",
