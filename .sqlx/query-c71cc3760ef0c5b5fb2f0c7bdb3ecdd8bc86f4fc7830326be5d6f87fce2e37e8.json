  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                space_id,\n                room_id,\n                sender,\n                is_suggested AS \"is_suggested!\",\n                ARRAY(SELECT jsonb_array_elements_text(via_servers)) as \"via_servers!\",\n                added_ts,\n                NULL::TEXT as \"order\",\n                NULL::BOOLEAN as suggested,\n                NULL::TEXT as added_by,\n                NULL::BIGINT as removed_ts\n            FROM space_children\n            WHERE room_id = $1\n            ",
