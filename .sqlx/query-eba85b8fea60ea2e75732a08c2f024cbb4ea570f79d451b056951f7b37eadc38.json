{
  "db_name": "PostgreSQL",
  "query": "\n            WITH fb AS (\n                SELECT id FROM device_keys\n                WHERE user_id = $1 AND device_id = $2 AND algorithm = $3 AND is_fallback = TRUE\n                LIMIT 1\n            )\n            UPDATE device_keys\n            SET fallback_used = TRUE, ts_updated_ms = $4\n            WHERE id IN (SELECT id FROM fb)\n            RETURNING\n                user_id,\n                device_id,\n                algorithm,\n                key_id,\n                public_key,\n                signatures,\n                display_name,\n                added_ts,\n                ts_updated_ms,\n                key_data,\n                is_fallback\n            ",
