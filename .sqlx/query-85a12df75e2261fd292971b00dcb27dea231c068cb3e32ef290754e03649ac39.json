{
  "db_name": "PostgreSQL",
  "query": "SELECT space_id, room_id AS \"room_id!\", name, topic, avatar_url, creator, join_rule AS \"join_rule!\", visibility, created_ts, updated_ts, is_public AS \"is_public!\", parent_space_id, room_type\n            FROM spaces\n            WHERE is_public = TRUE\n              AND (($2::BIGINT IS NULL AND $3::TEXT IS NULL)\n                OR created_ts < $2\n                OR (created_ts = $2 AND space_id < $3))\n            ORDER BY created_ts DESC, space_id DESC\n            LIMIT $1",
