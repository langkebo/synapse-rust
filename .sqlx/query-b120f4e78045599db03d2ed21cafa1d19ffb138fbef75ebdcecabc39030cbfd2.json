{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT user_id, username, COALESCE(displayname, username) as displayname, avatar_url, created_ts, updated_ts\n            FROM users\n            WHERE user_id = ANY($1)\n              AND COALESCE(is_deactivated, FALSE) = FALSE\n              AND updated_ts > $2\n            ",
